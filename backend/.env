# Server
PORT=3000
BASE_URL=http://localhost:3000

# Postgres
PGHOST=localhost
PGPORT=5433
PGUSER=billflow
PGPASSWORD=billflow
PGDATABASE=billflow

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_SECRET=billflow-dev-secret-change-me
ADMIN_EMAIL=admin@billflow.dev
ADMIN_PASSWORD=admin123

# Demo tenant seed API key
DEMO_API_KEY=billflow_demo_key

# Razorpay test-mode webhook secret (used to sign/verify webhooks)
RAZORPAY_WEBHOOK_SECRET=billflow-razorpay-dev-secret

# Payment simulator delay before the "gateway" delivers the signed webhook
PAYMENT_SIM_DELAY_MS=5000

# Billing cycle-close frequency
CYCLE_CLOSE_INTERVAL_MS=30000

# Dunning ladder: retry Day 3, retry Day 7, suspend Day 10.
# For a fast demo set DUNNING_DELAYS=10s,20s,30s
# DUNNING_DELAYS=
